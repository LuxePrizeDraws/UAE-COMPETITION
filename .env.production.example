NODE_ENV=production
PORT=5000

# Database / Cache
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/uae_competition
REDIS_URL=redis://<host>:6379

# Security
JWT_SECRET=replace-with-long-random-secret
ENCRYPTION_KEY=replace-with-32-byte-key
SESSION_SECRET=replace-with-session-secret
CORS_ORIGINS=https://www.uae-competition.com,https://admin.uae-competition.com
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Services
STRIPE_PUBLIC_KEY=pk_live_replace
STRIPE_SECRET_KEY=sk_live_replace
STRIPE_WEBHOOK_SECRET=whsec_replace
SENDGRID_API_KEY=SG.replace
SENDGRID_FROM_EMAIL=noreply@uae-competition.com
TWILIO_ACCOUNT_SID=ACreplace
TWILIO_AUTH_TOKEN=replace
TWILIO_PHONE_NUMBER=+10000000000

# AWS
AWS_ACCESS_KEY_ID=AKIAREPLACE
AWS_SECRET_ACCESS_KEY=replace
AWS_S3_BUCKET=uae-competition-prod
AWS_REGION=eu-west-1

# Monitoring
SENTRY_DSN=https://replace@sentry.io/0000000
DATADOG_API_KEY=replace

# Platform URLs
API_URL=https://api.uae-competition.com
APP_URL=https://www.uae-competition.com
