DATABASE_URL=sqlite:./database.db
JWT_SECRET=your_jwt_secret_key_change_in_production
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
PAYMENT_PROVIDER=modular
STRIPE_CHECKOUT_URL=
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUDIT_API_TOKEN=change-me

# ─── Google AdSense / AdMob ───────────────────────────────────────────────────
# Sign up at https://admob.google.com or https://adsense.google.com
# Your publisher ID looks like: ca-pub-XXXXXXXXXXXXXXXX
VITE_GOOGLE_AD_CLIENT_ID=

# Ad unit slot IDs — create these in your AdSense/AdMob console
VITE_AD_UNIT_BANNER=              # Generic banner fallback
VITE_AD_UNIT_SIDEBAR=             # Generic sidebar fallback
VITE_AD_UNIT_HOME_TOP=            # Homepage top banner
VITE_AD_UNIT_HOME_FOOTER=         # Homepage footer banner
VITE_AD_UNIT_BETWEEN_COMPETITIONS= # Interstitial between competition cards
VITE_AD_UNIT_DASHBOARD_TOP=       # Dashboard top banner
VITE_AD_UNIT_DASHBOARD_FOOTER=    # Dashboard footer banner

# Tournament visibility (comma-separated)
ENABLED_TOURNAMENTS=chess,connect4

# Mental health AI mode: mock fallback by default
MENTAL_HEALTH_AI_MODE=mock
MENTAL_HEALTH_AI_ENDPOINT=
MENTAL_HEALTH_AI_API_KEY=
MENTAL_HEALTH_AI_ALLOWED_HOSTS=
