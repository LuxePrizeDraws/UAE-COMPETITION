DATABASE_URL=sqlite:./database.db
JWT_SECRET=your_jwt_secret_key_change_in_production
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
PAYMENT_PROVIDER=shopify

# ---------------------------------------------------------------------------
# Shopify Integration
# ---------------------------------------------------------------------------
# Your Shopify store domain (e.g. my-store.myshopify.com)
SHOPIFY_STORE_DOMAIN=

# Shopify Storefront API public access token (for creating checkout sessions)
SHOPIFY_STOREFRONT_TOKEN=

# Shopify Admin API token (for reading orders, optional)
SHOPIFY_ADMIN_TOKEN=

# Shopify Webhook secret – copy from Partners dashboard > Webhooks
SHOPIFY_WEBHOOK_SECRET=

# Shopify API version (default: 2024-10)
SHOPIFY_API_VERSION=2024-10

# Map competition IDs to Shopify product variant IDs (JSON)
# Example: {"1":"12345678901","2":"98765432109","3":"11122233344"}
SHOPIFY_VARIANT_MAP={}
