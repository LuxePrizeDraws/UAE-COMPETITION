PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Tournament visibility (comma-separated): chess,connect4
ENABLED_TOURNAMENTS=chess,connect4

# Mental health AI mode: mock (default fallback) or live (requires endpoint)
MENTAL_HEALTH_AI_MODE=mock
MENTAL_HEALTH_AI_ENDPOINT=
MENTAL_HEALTH_AI_API_KEY=
