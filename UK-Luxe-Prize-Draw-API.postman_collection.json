{
  "info": {
    "name": "UK Luxe Prize Draw Platform API",
    "description": "Complete API testing collection for all 8 competitions. Set the `baseUrl` variable to your backend URL before running.\n\nDefault: http://localhost:5000\n\nImport instructions:\n1. Open Postman\n2. Click Import\n3. Select this file\n4. Update `baseUrl` variable if needed\n5. Run any request!",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "description": "Backend API base URL. Change to your Railway/Heroku URL for staging."
    },
    {
      "key": "competitionId",
      "value": "1",
      "description": "Competition ID (1-10)"
    }
  ],
  "item": [
    {
      "name": "Health & Info",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            },
            "description": "Returns API status, timestamp, total competitions, and live count."
          },
          "response": []
        },
        {
          "name": "Root Info",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": ["{{baseUrl}}"],
              "path": [""]
            },
            "description": "Root endpoint – returns platform name and version."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Competitions",
      "item": [
        {
          "name": "Get All Competitions",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/competitions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "competitions"]
            },
            "description": "Returns all 8 competitions with prize details, entry prices, draw progress percentages, cash alternatives, and time remaining."
          },
          "response": []
        },
        {
          "name": "Get Competition by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/competitions/{{competitionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "competitions", "{{competitionId}}"]
            },
            "description": "Returns a single competition by ID. Change `competitionId` variable to 1-8."
          },
          "response": []
        },
