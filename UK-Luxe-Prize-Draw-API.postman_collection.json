    {
      "name": "Error Scenarios",
      "item": [
        {
          "name": "FAIL – No terms accepted",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 5,\n  \"termsAccepted\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/competitions/1/enter",
              "host": ["{{baseUrl}}"],
              "path": ["api", "competitions", "1", "enter"]
            },
            "description": "Expected: 400 – You must accept the terms and conditions to enter."
          },
          "response": []
        },
        {
          "name": "FAIL – Invalid quantity (0)",
          "request": {
            "method": "POST",
