{
  "info": {
    "name": "UK Luxe Prize Draw Platform API",
    "description": "Complete API testing collection for all 10 competitions. Set the `baseUrl` variable to your backend URL before running.\n\nDefault: http://localhost:5000\n\nImport instructions:\n1. Open Postman\n2. Click Import\n3. Select this file\n4. Update `baseUrl` variable if needed\n5. Run any request!",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "description": "Backend API base URL. Change to your Railway/Heroku URL for staging."
    },
    {
      "key": "competitionId",
      "value": "1",
      "description": "Competition ID (1-10)"
    }
  ],
  "item": [
    {
      "name": "Health & Info",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            },
            "description": "Returns API status, timestamp, total competitions, and live count."
          },
          "response": []
        },
        {
          "name": "Root Info",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                ""
              ]
            },
            "description": "Root endpoint \u2013 returns platform name and version."
          },
          "response": []
        }
      ]
    },
