{
  "name": "UAE-COMPETITION",
  "version": "1.0.0",
  "description": "Premium UAE luxury competition platform",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "nodemon --exec node --loader ts-node/esm server/index.ts",
    "dev:client": "cd client && vite",
    "build:server": "tsc",
    "build": "npm run build:server && cd client && vite build",
    "preview": "cd client && vite preview",
    "type-check": "tsc --noEmit",
    "test": "vitest"
  },
  "keywords": [
    "competition",
    "uae",
    "luxury",
    "platform"
  ],
  "author": "shugstarwork-maker",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.8",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.10.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.3",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
