{
  "name": "UAE-COMPETITION",
  "version": "1.0.0",
  "description": "Premium UAE luxury competition platform",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "postinstall": "node -e \"process.exit(process.env.RAILWAY_ENVIRONMENT ? 0 : 1)\" || npm --prefix client install",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "nodemon --exec ts-node-esm server/index.ts",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "build:server": "tsc -p tsconfig.server.json",
    "preview": "npm --prefix client run preview",
    "type-check": "tsc -p client/tsconfig.json --noEmit",
    "test": "vitest --passWithNoTests",
    "start": "node dist/server/index.js"
  },
  "keywords": [
    "competition",
    "uae",
    "luxury",
    "platform"
  ],
  "author": "shugstarwork-maker",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "pg": "^8.11.3",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.20",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.10",
    "@types/node": "^20.8.9",
    "@types/pg": "^8.10.7",
    "@vitejs/plugin-react": "^4.2.0",
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2",
    "vite": "^5.0.2",
    "vitest": "^0.34.6"
  }
}
