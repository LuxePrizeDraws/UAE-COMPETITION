{
  "name": "uk-luxe-prize-draw",
  "version": "1.0.0",
  "description": "Premium UK luxury competition platform",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "predev": "npm --prefix client install --include=dev",
    "prebuild": "npm --prefix client install --include=dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "nodemon --exec \"ts-node-esm\" server/index.ts",
    "dev:client": "npm --prefix client run dev",
    "demo": "npm --prefix client install --include=dev && npm --prefix client run build && npm --prefix client run preview -- --host 0.0.0.0 --port 4173",
    "build": "npm --prefix client run build",
    "preview": "npm --prefix client run preview",
    "type-check": "tsc --noEmit",
    "test": "vitest"
  },
  "keywords": [
    "competition",
    "uk",
    "luxury",
    "platform"
  ],
  "author": "shugstarwork-maker",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "nodemon": "^3.0.1",
    "pg": "^8.11.3",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/express": "^4.17.20",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.8.9",
    "@types/pg": "^8.10.7",
    "@vitejs/plugin-react": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "vite": "^5.0.2",
    "vitest": "^0.34.6"
  }
}
